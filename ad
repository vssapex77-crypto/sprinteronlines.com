<!-- =====================================================
     TELEGRAM CLICK TRACKING
====================================================== -->

<script>

    document.addEventListener(
        "DOMContentLoaded",
        function () {


            /* =============================================
               FIRST TELEGRAM BUTTON
            ============================================== */

            var telegramTop =
                document.getElementById(
                    "telegram-cta"
                );


            if (telegramTop) {

                telegramTop.addEventListener(
                    "click",
                    function () {

                        if (
                            typeof fbq ===
                            "function"
                        ) {

                            fbq(
                                "trackCustom",
                                "TelegramClick"
                            );

                        }

                    }
                );

            }


            /* =============================================
               SECOND TELEGRAM BUTTON
            ============================================== */

            var telegramBottom =
                document.getElementById(
                    "telegram-cta-bottom"
                );


            if (telegramBottom) {

                telegramBottom.addEventListener(
                    "click",
                    function () {

                        if (
                            typeof fbq ===
                            "function"
                        ) {

                            fbq(
                                "trackCustom",
                                "TelegramClick"
                            );

                        }

                    }
                );

            }


        }
    );

</script>


