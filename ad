<!DOCTYPE html>
<html lang="en">

<head>

    <!-- =====================================================
         BASIC SEO
    ====================================================== -->

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <meta name="description"
          content="Sprinters Online - Online services, digital information, community updates and announcements.">

    <meta name="robots"
          content="index, follow">

    <link rel="canonical"
          href="https://www.sprinteronlines.com/">

    <title>Sprinters Online | Online Services & Updates</title>


    <!-- =====================================================
         FAVICON
         Optional - add your favicon later
    ====================================================== -->

    <!--
    <link rel="icon"
          type="image/png"
          href="assets/images/sprinterslogo.png">
    -->


    <!-- =====================================================
         STYLES
    ====================================================== -->

    <style>

        /* =================================================
           RESET
        ================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        html {
            scroll-behavior: smooth;
        }


        body {

            font-family:
                Arial,
                Helvetica,
                sans-serif;

            background: #0b1717;

            color: #ffffff;

            line-height: 1.6;

            -webkit-font-smoothing: antialiased;

        }


        /* =================================================
           PAGE
        ================================================== */

        .page {

            min-height: 100vh;

            display: flex;

            flex-direction: column;

        }


        /* =================================================
           HEADER
        ================================================== */

        header {

            width: 100%;

            background: #101f1f;

            border-bottom:
                1px solid
                rgba(255, 255, 255, 0.08);

        }


        .nav {

            width: 100%;

            max-width: 1150px;

            min-height: 72px;

            margin: 0 auto;

            padding:
                0 25px;

            display: flex;

            align-items: center;

            justify-content: space-between;

        }


        .brand {

            font-size: 22px;

            font-weight: 800;

            letter-spacing: 2px;

        }


        .nav-links {

            display: flex;

            align-items: center;

            gap: 28px;

        }


        .nav-links a {

            color: #d8e1e1;

            text-decoration: none;

            font-size: 14px;

            font-weight: 600;

            transition:
                opacity 0.2s ease;

        }


        .nav-links a:hover {

            opacity: 0.7;

        }


        /* =================================================
           HERO
        ================================================== */

        .hero {

            min-height: 650px;

            display: flex;

            align-items: center;

            justify-content: center;

            padding:
                70px 20px;

            background:

                radial-gradient(
                    circle at 50% 30%,
                    #244141 0%,
                    #142626 35%,
                    #0b1717 72%
                );

        }


        .hero-inner {

            width: 100%;

            max-width: 900px;

            margin: 0 auto;

            text-align: center;

        }


        /* =================================================
           LOGO
        ================================================== */

        .logo {

            width: 310px;

            max-width: 82%;

            height: auto;

            display: block;

            margin:
                0 auto 35px;

        }


        /* =================================================
           BADGE
        ================================================== */

        .badge {

            display: inline-block;

            padding:
                7px 17px;

            margin-bottom: 22px;

            border:
                1px solid
                rgba(255, 255, 255, 0.14);

            border-radius: 50px;

            background:
                rgba(255, 255, 255, 0.04);

            color: #dce7e7;

            font-size: 11px;

            font-weight: 700;

            letter-spacing: 1.8px;

            text-transform: uppercase;

        }


        /* =================================================
           MAIN HEADING
        ================================================== */

        h1 {

            font-size:
                clamp(
                    40px,
                    7vw,
                    70px
                );

            line-height: 1.05;

            letter-spacing: -2px;

            margin-bottom: 22px;

        }


        /* =================================================
           HERO TEXT
        ================================================== */

        .hero-text {

            max-width: 670px;

            margin:
                0 auto 32px;

            color: #b7c5c5;

            font-size: 18px;

            line-height: 1.7;

        }


        /* =================================================
           CTA
        ================================================== */

        .cta {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            min-width: 215px;

            padding:
                16px 30px;

            border-radius: 8px;

            background: #229ed9;

            color: #ffffff;

            text-decoration: none;

            font-size: 16px;

            font-weight: 800;

            box-shadow:
                0 8px 25px
                rgba(34, 158, 217, 0.18);

            transition:
                transform 0.2s ease,
                opacity 0.2s ease,
                box-shadow 0.2s ease;

        }


        .cta:hover {

            transform:
                translateY(-2px);

            opacity: 0.92;

            box-shadow:
                0 12px 30px
                rgba(34, 158, 217, 0.25);

        }


        /* =================================================
           SMALL HERO NOTE
        ================================================== */

        .hero-note {

            margin-top: 20px;

            color: #829494;

            font-size: 12px;

        }


        /* =================================================
           FEATURES SECTION
        ================================================== */

        .features-section {

            padding:
                80px 20px;

            background: #0f1e1e;

        }


        .section-heading {

            max-width: 750px;

            margin:
                0 auto 45px;

            text-align: center;

        }


        .section-heading h2 {

            font-size:
                clamp(
                    30px,
                    5vw,
                    42px
                );

            margin-bottom: 12px;

        }


        .section-heading p {

            color: #91a3a3;

            font-size: 15px;

        }


        .features {

            width: 100%;

            max-width: 1100px;

            margin: 0 auto;

            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 22px;

        }


        /* =================================================
           FEATURE CARD
        ================================================== */

        .feature {

            padding: 30px;

            background: #152828;

            border:
                1px solid
                rgba(255, 255, 255, 0.07);

            border-radius: 14px;

            transition:
                transform 0.2s ease,
                border-color 0.2s ease;

        }


        .feature:hover {

            transform:
                translateY(-4px);

            border-color:
                rgba(255, 255, 255, 0.14);

        }


        .feature-number {

            width: 42px;

            height: 42px;

            display: flex;

            align-items: center;

            justify-content: center;

            margin-bottom: 20px;

            border-radius: 10px;

            background:
                rgba(255, 255, 255, 0.07);

            color: #dce7e7;

            font-size: 13px;

            font-weight: 800;

        }


        .feature h3 {

            font-size: 20px;

            margin-bottom: 10px;

        }


        .feature p {

            color: #91a3a3;

            font-size: 14px;

            line-height: 1.7;

        }


        /* =================================================
           ABOUT SECTION
        ================================================== */

        .about {

            padding:
                80px 20px;

            background: #111f1f;

        }


        .about-inner {

            max-width: 850px;

            margin: 0 auto;

            text-align: center;

        }


        .about-inner h2 {

            font-size:
                clamp(
                    30px,
                    5vw,
                    40px
                );

            margin-bottom: 18px;

        }


        .about-inner p {

            color: #a0b0b0;

            font-size: 15px;

            line-height: 1.8;

            margin-bottom: 15px;

        }


        /* =================================================
           CTA SECTION
        ================================================== */

        .cta-section {

            padding:
                75px 20px;

            background: #0d1b1b;

            text-align: center;

        }


        .cta-section h2 {

            font-size:
                clamp(
                    28px,
                    5vw,
                    40px
                );

            margin-bottom: 12px;

        }


        .cta-section p {

            max-width: 600px;

            margin:
                0 auto 25px;

            color: #91a3a3;

            font-size: 15px;

        }


        /* =================================================
           FOOTER
        ================================================== */

        footer {

            margin-top: auto;

            padding:
                35px 20px;

            background: #081111;

            text-align: center;

            border-top:
                1px solid
                rgba(255, 255, 255, 0.06);

        }


        .footer-brand {

            font-size: 17px;

            font-weight: 800;

            letter-spacing: 1.5px;

            margin-bottom: 10px;

        }


        footer p {

            color: #6f8080;

            font-size: 12px;

            margin-bottom: 18px;

        }


        .footer-links {

            display: flex;

            align-items: center;

            justify-content: center;

            flex-wrap: wrap;

            gap: 22px;

        }


        .footer-links a {

            color: #9baaaa;

            text-decoration: none;

            font-size: 12px;

        }


        .footer-links a:hover {

            text-decoration: underline;

        }


        /* =================================================
           MOBILE
        ================================================== */

        @media (max-width: 750px) {


            .nav {

                min-height: 65px;

                padding:
                    0 18px;

            }


            .brand {

                font-size: 19px;

            }


            .nav-links {

                display: none;

            }


            .hero {

                min-height: 610px;

                padding:
                    55px 20px;

            }


            .logo {

                width: 255px;

                margin-bottom: 30px;

            }


            .hero-text {

                font-size: 16px;

                line-height: 1.65;

            }


            .features-section {

                padding:
                    60px 20px;

            }


            .features {

                grid-template-columns: 1fr;

            }


            .feature {

                padding: 25px;

            }


            .about {

                padding:
                    60px 20px;

            }


            .cta-section {

                padding:
                    60px 20px;

            }

        }


    </style>


    <!-- =====================================================
         META PIXEL
    ====================================================== -->

    <script>

        !function(f,b,e,v,n,t,s)
        {
            if(f.fbq)return;

            n=f.fbq=function()
            {
                n.callMethod ?
                n.callMethod.apply(n,arguments) :
                n.queue.push(arguments)
            };

            if(!f._fbq)f._fbq=n;

            n.push=n;
            n.loaded=!0;
            n.version='2.0';
            n.queue=[];

            t=b.createElement(e);

            t.async=!0;

            t.src=v;

            s=b.getElementsByTagName(e)[0];

            s.parentNode.insertBefore(t,s);

        }(
            window,
            document,
            'script',
            'https://connect.facebook.net/en_US/fbevents.js'
        );


        /* PIXEL 1 */

        fbq(
            'init',
