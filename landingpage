```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sprinter Online | Official Website</title>

    <meta
        name="description"
        content="Visit the official Sprinter Online website for information, services, eligibility and applicable terms."
    >

    <meta name="robots" content="index, follow">

    <meta
        property="og:title"
        content="Sprinter Online | Official Website"
    >

    <meta
        property="og:description"
        content="Official Sprinter Online information and services."
    >

    <meta property="og:type" content="website">

    <meta
        property="og:url"
        content="https://www.sprinteronlines.com/"
    >

    <!-- Replace with your own stylesheet if hosted separately -->
    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family:
                Arial,
                Helvetica,
                sans-serif;
            background: #070707;
            color: #ffffff;
            line-height: 1.6;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        img {
            max-width: 100%;
            display: block;
        }

        .container {
            width: min(1120px, 92%);
            margin: auto;
        }

        /* =========================
           HEADER
        ========================= */

        header {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(7, 7, 7, 0.94);
            border-bottom: 1px solid rgba(255,255,255,0.08);
            backdrop-filter: blur(12px);
        }

        .header-inner {
            min-height: 76px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .logo {
            display: flex;
            align-items: center;
        }

        .logo img {
            width: 155px;
            height: auto;
        }

        .header-link {
            padding: 10px 20px;
            border: 1px solid rgba(255,255,255,0.18);
            border-radius: 50px;
            font-size: 14px;
            font-weight: 700;
            transition: 0.25s ease;
        }

        .header-link:hover {
            background: #ffffff;
            color: #000000;
        }

        /* =========================
           HERO
        ========================= */

        .hero {
            min-height: 720px;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
            background:
                radial-gradient(
                    circle at 80% 20%,
                    rgba(0, 220, 255, 0.13),
                    transparent 35%
                ),
                radial-gradient(
                    circle at 15% 70%,
                    rgba(0, 150, 255, 0.08),
                    transparent 35%
                ),
                #070707;
        }

        .hero::before {
            content: "";
            position: absolute;
            width: 500px;
            height: 500px;
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 50%;
            right: -180px;
            top: 70px;
        }

        .hero-content {
            max-width: 760px;
            position: relative;
            z-index: 2;
        }

        .eyebrow {
            display: inline-flex;
            padding: 7px 14px;
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 30px;
            font-size: 11px;
            letter-spacing: 2px;
            font-weight: 700;
            margin-bottom: 25px;
            color: #bcbcbc;
        }

        .hero h1 {
            font-size: clamp(42px, 7vw, 82px);
            line-height: 0.98;
            letter-spacing: -3px;
            margin-bottom: 25px;
        }

        .hero h1 span {
            display: block;
            background: linear-gradient(
                90deg,
                #ffffff,
                #8deaff
            );
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero p {
            max-width: 610px;
            color: #a7a7a7;
            font-size: 18px;
            margin-bottom: 35px;
        }

        .hero-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 52px;
            padding: 0 28px;
            border-radius: 8px;
            font-weight: 800;
            font-size: 14px;
            transition: 0.25s ease;
        }

        .btn-primary {
            background: #ffffff;
            color: #000000;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
        }

        .btn-secondary {
            border: 1px solid rgba(255,255,255,0.18);
            color: #ffffff;
        }

        .btn-secondary:hover {
            background: rgba(255,255,255,0.08);
        }

        /* =========================
           STATS
        ========================= */

        .stats {
            border-top: 1px solid rgba(255,255,255,0.08);
            border-bottom: 1px solid rgba(255,255,255,0.08);
            background: #0b0b0b;
        }

        .stats-grid {
            display: grid;
            grid-template-columns:
                repeat(3, 1fr);
        }

        .stat {
            padding: 30px 20px;
            text-align: center;
            border-right: 1px solid rgba(255,255,255,0.08);
        }

        .stat:last-child {
            border-right: 0;
        }

        .stat strong {
            display: block;
            font-size: 28px;
            margin-bottom: 4px;
        }

        .stat span {
            color: #8e8e8e;
            font-size: 13px;
        }

        /* =========================
           INFORMATION
        ========================= */

        .section {
            padding: 100px 0;
        }

        .section-heading {
            max-width: 650px;
            margin-bottom: 45px;
        }

        .section-heading small {
            display: block;
            color: #8deaff;
            letter-spacing: 2px;
            font-size: 11px;
            font-weight: 800;
            margin-bottom: 12px;
        }

        .section-heading h2 {
            font-size: clamp(32px, 5vw, 52px);
            line-height: 1.05;
            margin-bottom: 16px;
        }

        .section-heading p {
            color: #969696;
        }

        .cards {
            display: grid;
            grid-template-columns:
                repeat(3, 1fr);
            gap: 18px;
        }

        .card {
            padding: 32px;
            min-height: 230px;
            background: linear-gradient(
                145deg,
                #111111,
                #0a0a0a
            );
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
            transition: 0.25s ease;
        }

        .card:hover {
            transform: translateY(-5px);
            border-color: rgba(255,255,255,0.18);
        }

        .card-number {
            font-size: 12px;
            color: #777777;
            margin-bottom: 35px;
        }

        .card h3 {
            font-size: 21px;
            margin-bottom: 10px;
        }

        .card p {
            color: #8e8e8e;
            font-size: 14px;
        }

        /* =========================
           STEPS
        ========================= */

        .steps-section {
            background: #0b0b0b;
        }

        .steps {
            display: grid;
            grid-template-columns:
                repeat(3, 1fr);
            gap: 30px;
        }

        .step {
            position: relative;
            padding-left: 55px;
        }

        .step-number {
            position: absolute;
            left: 0;
            top: 0;
            font-size: 13px;
            font-weight: 800;
            color: #8deaff;
        }

        .step h3 {
            margin-bottom: 8px;
            font-size: 19px;
        }

        .step p {
            color: #888888;
            font-size: 14px;
        }

        /* =========================
           FAQ
        ========================= */

        .faq {
            max-width: 850px;
        }

        details {
            border-top: 1px solid rgba(255,255,255,0.1);
            padding: 22px 0;
        }

        details:last-child {
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        summary {
            cursor: pointer;
            font-weight: 700;
            font-size: 16px;
        }

        details p {
            color: #888888;
            margin-top: 14px;
            font-size: 14px;
            max-width: 700px;
        }

        /* =========================
           CTA
        ========================= */

        .cta-box {
            text-align: center;
            padding: 70px 25px;
            border-radius: 20px;
            background:
                radial-gradient(
                    circle at center,
                    rgba(0, 220, 255, 0.10),
                    transparent 55%
                ),
                #101010;
            border: 1px solid rgba(255,255,255,0.08);
        }

        .cta-box h2 {
            font-size: clamp(30px, 5vw, 50px);
            margin-bottom: 15px;
        }

        .cta-box p {
            color: #8d8d8d;
            max-width: 600px;
            margin: 0 auto 28px;
        }

        /* =========================
           FOOTER
        ========================= */

        footer {
            border-top: 1px solid rgba(255,255,255,0.08);
            padding: 45px 0;
            background: #050505;
        }

        .footer-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
        }

        .footer-logo img {
            width: 130px;
        }

        .footer-text {
            color: #666666;
            font-size: 12px;
        }

        .footer-links {
            display: flex;
            gap: 18px;
            flex-wrap: wrap;
            font-size: 12px;
            color: #858585;
        }

        .footer-links a:hover {
            color: #ffffff;
        }

        /* =========================
           MOBILE
        ========================= */

        @media (max-width: 800px) {

            .hero {
                min-height: 650px;
            }

            .hero h1 {
                letter-spacing: -2px;
            }

            .hero p {
                font-size: 16px;
            }

            .cards,
            .steps {
                grid-template-columns: 1fr;
            }

            .stats-grid {
                grid-template-columns: 1fr;
            }

            .stat {
                border-right: 0;
                border-bottom: 1px solid rgba(255,255,255,0.08);
            }

            .stat:last-child {
                border-bottom: 0;
            }

            .section {
                padding: 75px 0;
            }

            .footer-inner {
                flex-direction: column;
                align-items: flex-start;
            }
        }

        @media (max-width: 520px) {

            .header-inner {
                min-height: 65px;
            }

            .logo img {
                width: 125px;
            }

            .header-link {
                padding: 8px 14px;
                font-size: 12px;
            }

            .hero {
                min-height: 620px;
            }

            .hero h1 {
                font-size: 48px;
            }

            .hero-buttons {
                flex-direction: column;
            }

            .btn {
                width: 100%;
            }

            .card {
                min-height: auto;
            }

            .cta-box {
                padding: 50px 20px;
            }
        }

    </style>
</head>


